  "scenes": [
    {
      "id": "tamamlama",
      "title": "Eksik parçayı bul",
      "speaker": "filiz",
      "kind": "intro",
      "theme": "light",
      "parts": [
        {
          "text": "Cümleyi tamamlamak, eksik parçayı yerine yerleştirmektir. Boşluk başta, ortada ya da sonda olabilir.",
          "audio": "audio/turkce/cumle-genel-design/tamamlama-0-ec4cb839.mp3",
          "from": 0,
          "frames": 249,
          "seconds": 8.28
        },
        {
          "text": "Sözcük veya sözcük öbeği seçeriz. Parça hem anlama hem cümlenin yapısına uymalıdır.",
          "audio": "audio/turkce/cumle-genel-design/tamamlama-1-f8e510f5.mp3",
          "from": 257,
          "frames": 228,
          "seconds": 7.584
        },
        {
          "text": "Sözcük anlamı, deyimler ve sözcük türleri doğru parçayı bulmamıza yardım eder.",
          "audio": "audio/turkce/cumle-genel-design/tamamlama-2-2d31d536.mp3",
          "from": 493,
          "frames": 186,
          "seconds": 6.168
        }
      ],
      "from": 0,
      "frames": 697
    },
    {
